<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="splash"
            android:width="320dp"
            android:height="320dp"
            android:viewportWidth="320"
            android:viewportHeight="320">

            <!-- Cyber Hexagon Outer Glow Ring -->
            <path
                android:name="splash_ring"
                android:pathData="M 160,40 L 260,98 L 260,214 L 160,272 L 60,214 L 60,98 Z"
                android:strokeColor="#1E3A8A"
                android:strokeWidth="1.5"
                android:strokeAlpha="0.6"
                android:fillAlpha="0" />

            <!-- Main Cyber Hexagon Badge -->
            <path
                android:name="splash_hexagon"
                android:pathData="M 160,55 L 245,104 L 245,208 L 160,257 L 75,208 L 75,104 Z"
                android:fillColor="#0D1527"
                android:strokeColor="#00E5FF"
                android:strokeWidth="3.5"
                android:strokeLineJoin="round"
                android:fillAlpha="0" />

            <!-- Inner Accent Frame -->
            <path
                android:name="splash_inner_frame"
                android:pathData="M 160,70 L 230,111 L 230,201 L 160,242 L 90,201 L 90,111 Z"
                android:fillColor="#0A0F1D"
                android:strokeColor="#2979FF"
                android:strokeWidth="1.5"
                android:strokeLineJoin="round"
                android:fillAlpha="0" />

            <!-- Monogram O -->
            <path
                android:name="splash_letter_o"
                android:pathData="M 128,124 L 146,134 L 146,178 L 128,188 L 110,178 L 110,134 Z M 128,138 L 119,143 L 119,169 L 128,174 L 137,169 L 137,143 Z"
                android:fillColor="#00E5FF"
                android:fillAlpha="0" />

            <!-- Monogram X -->
            <path
                android:name="splash_letter_x"
                android:pathData="M 158,126 L 170,126 L 183,153 L 196,126 L 208,126 L 190,157 L 210,192 L 198,192 L 183,163 L 168,192 L 156,192 L 176,157 Z"
                android:fillColor="#00E5FF"
                android:fillAlpha="0" />

            <!-- Core White Neon Accent Lines -->
            <path
                android:name="splash_neon_accent"
                android:pathData="M 128,130 L 141,137 L 141,175 L 128,182 L 115,175 L 115,137 Z"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1"
                android:strokeAlpha="0.7"
                android:fillAlpha="0" />

        </vector>
    </aapt:attr>

    <!-- Background Hexagon Animation -->
    <target android:name="splash_hexagon">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:startOffset="50"
                    android:duration="400"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <!-- Inner Frame Animation -->
    <target android:name="splash_inner_frame">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:startOffset="100"
                    android:duration="400"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <!-- Letter O Animation -->
    <target android:name="splash_letter_o">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:startOffset="150"
                    android:duration="350"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <!-- Letter X Animation -->
    <target android:name="splash_letter_x">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:startOffset="200"
                    android:duration="350"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <!-- Neon Accent Animation -->
    <target android:name="splash_neon_accent">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:startOffset="250"
                    android:duration="350"
                    android:valueFrom="0"
                    android:valueTo="0.85"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>